@startuml 01-web
title Sistema Web - Casos de uso
left to right direction
skinparam nodesep 6
skinparam ranksep 80
skinparam packageStyle rectangle
skinparam shadowing false
skinparam actorStyle awesome

actor "Administrador" as Admin
actor "Generador de Proformas" as Generador

rectangle "Sistema Web" {
  package "Acceso" {
    usecase "Iniciar sesión" as CU01
    usecase "Cerrar sesión" as CU03
    usecase "Gestionar cuenta" as CU04
  }
  package "Clientes" {
    usecase "Gestionar clientes" as CU05
  }
  package "Productos" {
    usecase "Gestionar productos" as CU06
  }
  package "Proformas" {
    usecase "Gestionar proformas" as CU07
    usecase "Previsualizar proforma" as CU11
    usecase "Exportar PDF" as CU12
    usecase "Exportar Excel" as CU13
  }
}

Admin --> CU01
Admin --> CU03
Admin --> CU04
Admin --> CU05
Admin --> CU06
Admin --> CU07
Admin --> CU11
Admin --> CU12
Admin --> CU13

CU11 --> Generador : solicita imagen
CU12 --> Generador : solicita PDF
CU13 --> Generador : solicita Excel

@enduml
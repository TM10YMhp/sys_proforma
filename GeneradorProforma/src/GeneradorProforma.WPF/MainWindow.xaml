<Window x:Class="GeneradorProforma.WPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:local="clr-namespace:GeneradorProforma.WPF"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        Title="sys-proforma"
        Width="500"
        Height="350"
        mc:Ignorable="d">

  <Window.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/Styles/MainWindowResources.xaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Window.Resources>

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <Border Grid.Row="0"
            Padding="8,4">
      <TextBlock VerticalAlignment="Center"
                 FontSize="16"
                 FontWeight="Bold"
                 Text="SYS PROFORMA" />
    </Border>

    <Border Grid.Row="1"
            Padding="4">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="100" />
          <ColumnDefinition Width="80" />
          <ColumnDefinition Width="80" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="30" />
          <RowDefinition Height="30" />
        </Grid.RowDefinitions>

        <!--  encabezado  -->
        <TextBlock Grid.Row="0"
                   Grid.Column="0"
                   Style="{StaticResource HeaderTextStyle}"
                   Text="Servicio" />
        <TextBlock Grid.Row="0"
                   Grid.Column="1"
                   Style="{StaticResource HeaderTextStyle}"
                   Text="PID(s)" />
        <TextBlock Grid.Row="0"
                   Grid.Column="2"
                   Style="{StaticResource HeaderTextStyle}"
                   Text="Puerto(s)" />
        <TextBlock Grid.Row="0"
                   Grid.Column="3"
                   Margin="10,0,0,0"
                   HorizontalAlignment="Left"
                   Style="{StaticResource HeaderTextStyle}"
                   Text="Acciones" />

        <!--  primera fila  -->
        <Border Grid.Row="1"
                Grid.Column="0"
                Style="{StaticResource StatusBorderStyle}">
          <TextBlock HorizontalAlignment="Center"
                     VerticalAlignment="Center"
                     FontWeight="SemiBold"
                     Text="Web" />
        </Border>
        <TextBlock Grid.Row="1"
                   Grid.Column="1"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"
                   FontFamily="Consolas" />
        <TextBlock Grid.Row="1"
                   Grid.Column="2"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"
                   FontFamily="Consolas" />
        <StackPanel Grid.Row="1"
                    Grid.Column="3"
                    Margin="4,0,0,0"
                    Orientation="Horizontal">
          <Button Width="65"
                  Height="25" />
          <!--<Button Content="Config" Width="65" Height="25" Margin="0,0,5,0" Background="White"/>-->
        </StackPanel>

        <!--  segunda fila  -->
        <Border Grid.Row="2"
                Grid.Column="0"
                Style="{StaticResource StatusBorderStyle}">
          <TextBlock HorizontalAlignment="Center"
                     VerticalAlignment="Center"
                     FontWeight="SemiBold"
                     Text="Generador" />
        </Border>
        <TextBlock Grid.Row="2"
                   Grid.Column="1"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"
                   FontFamily="Consolas"
                   Text="--" />
        <TextBlock Grid.Row="2"
                   Grid.Column="2"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"
                   FontFamily="Consolas"
                   Text="--" />
        <StackPanel Grid.Row="2"
                    Grid.Column="3"
                    Margin="4,0,0,0"
                    Orientation="Horizontal">
          <Button Width="65"
                  Height="25" />
        </StackPanel>
      </Grid>
    </Border>

    <GroupBox Grid.Row="2"
              Header="Registros">

      <TabControl x:Name="miTabControl">
        <TabItem Header="Web">
          <TextBox Padding="4"
                   Background="#000000"
                   FontFamily="Consolas"
                   FontSize="11"
                   Foreground="#ffffff"
                   IsReadOnly="True"
                   Text="web"
                   TextWrapping="Wrap"
                   VerticalScrollBarVisibility="Auto" />
        </TabItem>

        <TabItem Header="Generador">
          <TextBox Padding="4"
                   Background="#000000"
                   FontFamily="Consolas"
                   FontSize="11"
                   Foreground="#ffffff"
                   IsReadOnly="True"
                   Text="generador"
                   TextWrapping="Wrap"
                   VerticalScrollBarVisibility="Auto" />
        </TabItem>
      </TabControl>
    </GroupBox>
  </Grid>
</Window>
